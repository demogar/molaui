{
  "name": "@demogar/mola-ui",
  "version": "0.8.0",
  "description": "A design system cut like a mola: flat layers, hard keylines, revealed bands. React components for dense internal tools and AI-native interfaces.",
  "license": "MIT",
  "author": "Demóstenes García (https://github.com/demogar)",
  "homepage": "https://demogar.github.io/molaui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demogar/molaui.git"
  },
  "bugs": {
    "url": "https://github.com/demogar/molaui/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "base-ui",
    "design-tokens",
    "storybook",
    "ai",
    "agents",
    "components"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "docs/ai/components.json",
    "docs/ai/tokens.json",
    "snippets"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mola-ui-mcp": "dist/mcp/mola-ui-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/mola-ui.css",
    "./components.css": "./dist/mola-ui-components.css",
    "./tailwind.css": "./dist/tailwind/mola.css",
    "./tokens.css": "./dist/tailwind/tokens.css",
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "build": "vite build && vite build -c vite.css.config.ts && vite build -c vite.mcp.config.ts && vite build -c vite.eslint.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run deps:audit && npm run tokens:check && npm run manifest:check && npm run figma:check && npm run evidence:check && npm run build && npm run api:check && npm run size && npm run build-storybook",
    "check:browser": "npm run build-storybook && npm run audit && npm run visual",
    "check:all": "npm run check && npm run check:browser && npm run consumers",
    "tokens": "tsx scripts/export-tokens.ts",
    "tokens:check": "tsx scripts/export-tokens.ts --check",
    "manifest": "tsx scripts/export-manifest.ts",
    "manifest:check": "tsx scripts/export-manifest.ts --check",
    "figma": "tsx scripts/export-figma.ts",
    "figma:check": "tsx scripts/export-figma.ts --check",
    "evidence": "tsx scripts/export-evidence.ts",
    "evidence:check": "tsx scripts/export-evidence.ts --check",
    "api": "api-extractor run --local",
    "api:check": "api-extractor run",
    "size": "size-limit",
    "audit": "node scripts/audit.mjs --serve storybook-static --out reports/audit",
    "visual": "playwright test -c test/visual/playwright.config.ts",
    "visual:update": "playwright test -c test/visual/playwright.config.ts --update-snapshots=changed",
    "consumers": "node scripts/consumers.mjs",
    "deps:audit": "node scripts/deps.mjs"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/alegreya": "5.3.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@microsoft/api-extractor": "7.59.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.0",
    "@size-limit/preset-small-lib": "14.2.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "playwright": "1.64.0",
    "react": "19.3.0",
    "react-docgen-typescript": "2.4.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "size-limit": "14.2.0",
    "storybook": "10.6.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.3",
    "zod": "4.6.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
